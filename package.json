{
  "name": "squawk-mcp",
  "version": "0.1.0",
  "description": "Ask your AI what's flying overhead. A read-only MCP server for live flight data from the OpenSky Network.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "squawk-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "keywords": [
    "mcp",
    "opensky",
    "ads-b",
    "flights",
    "aviation",
    "squawk"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/philliwilly-cyber/squawk-mcp.git"
  }
}
