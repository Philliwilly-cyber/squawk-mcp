# OpenSky API client (create one at https://opensky-network.org/my-opensky/account).
# Leave empty to run in anonymous mode (400 credits/day per IP, latest data only).
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Optional: where downloaded CSVs and the geocoding cache are stored.
# Defaults to $XDG_CACHE_HOME/squawk-mcp or ~/.cache/squawk-mcp.
SQUAWK_CACHE_DIR=
